# Copy this file to release.env after the image build. Do not commit release.env.
CINTA_SOURCE_REVISION=replace-with-reviewed-full-sha
CINTA_IMAGE=sha256:replace-with-reviewed-image-id
CINTA_RUNS_ROOT=/srv/hackspain-coffee/runs
CINTA_ITEM_CONTROL_ROOT=/srv/hackspain-coffee/item-control
CINTA_ITEM_JOBS_PROVIDER=paid
CINTA_PROVIDER_CACHE_ROOT=/srv/hackspain-coffee/provider-cache
CINTA_PROVIDER_ENV_FILE=/srv/hackspain-coffee/secrets/generated-items.env
CINTA_PHYSICS_REPLAY_ROOT=/srv/hackspain-coffee/provider-replay
CINTA_OPERATOR_USER=replace-with-operator-user
CINTA_OPERATOR_PASSWORD_HASH=replace-with-caddy-password-hash
