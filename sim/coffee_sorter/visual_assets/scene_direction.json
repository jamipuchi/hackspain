{
  "version": 1,
  "conventions": {
    "space": "Metres, right-handed, +Z up, +X along the belt toward discharge, Y across the belt. Same space as RECORDING.md and replay.json.",
    "camera": "location and target in metres. 36 mm sensor, horizontal sensor fit, so the horizontal framing survives an aspect change. focus_distance_m is explicit and is not recomputed.",
    "lights": "Area lights only. energy_w is Blender watts. size_m is [x, y] for RECTANGLE and a diameter for DISK. Local x of an aimed light is horizontal. spread_deg below 180 acts as a grid and limits spill. glossy false removes the light from reflections.",
    "exposure": "Final exposure is looks[look].color_management.exposure plus rigs[rig].exposure_offset."
  },
  "machine_bounds_m": {
    "min": [-1.192, -0.32, 0.0],
    "max": [0.763, 0.32, 1.05],
    "source": "Tight bounds of replay['machine'] without the floor, rotations included. Added machine detail can exceed them."
  },
  "render_hints": {
    "note": "Not applied by scene_lighting.py. render_scene.py owns render settings.",
    "engine": "CYCLES",
    "resolution": [1920, 1080],
    "motion_blur": false,
    "motion_blur_reason": "The replay is sampled near 30 Hz. Motion blur would invent trajectories between samples. See RECORDING.md.",
    "clamp_indirect": 10.0,
    "filter_glossy": 0.5,
    "min_samples_for_review": 64
  },
  "shots": {
    "hero": {
      "role": "The entire machine from the front, discharge end nearest. The machine fills about 58 percent of the frame width and 62 percent of the height at 16:9.",
      "rig": "hero",
      "aspect": [16, 9],
      "blueprint": {"edge_radius_m": 0.004},
      "camera": {
        "location": [1.95, -4.05, 1.75], "target": [-0.15, 0.0, 0.52],
        "lens_mm": 50, "sensor_width_mm": 36, "fstop": 5.6, "dof": true, "focus_distance_m": 4.635,
        "focus_note": "Nozzle bank and belt end (0.0, 0.0, 0.62).",
        "clip_start_m": 0.1, "clip_end_m": 200
      }
    },
    "inspection": {
      "role": "Low 20 mm view under the camera bridge, diagonal across the belt. Sharp beans at the scan line in the lower frame. Light bars and housing underside recede to the upper right.",
      "rig": "inspection",
      "aspect": [16, 9],
      "blueprint": {"edge_radius_m": 0.0008, "rim_range": [0.93, 0.99], "rim_note": "Computed, not re-rendered. The camera is 5 cm above the belt, so a wider range makes the far belt glow."},
      "camera": {
        "location": [-0.02, -0.235, 0.65], "target": [-0.16, 0.10, 0.70],
        "lens_mm": 20, "sensor_width_mm": 36, "fstop": 11, "dof": true, "focus_distance_m": 0.169,
        "focus_note": "Beans just past the scan line (-0.11, -0.10, 0.603).",
        "clip_start_m": 0.005, "clip_end_m": 100
      }
    },
    "discharge": {
      "role": "Three-quarter view from the discharge end, above the near chute wall. Nozzle bank across the upper third, belt end behind it, splitter in the centre and lower right.",
      "rig": "discharge",
      "aspect": [16, 9],
      "blueprint": {"edge_radius_m": 0.0015, "rim_range": [0.88, 0.97]},
      "camera": {
        "location": [1.25, -0.42, 1.10], "target": [0.18, 0.0, 0.57],
        "lens_mm": 35, "sensor_width_mm": 36, "fstop": 8, "dof": true, "focus_distance_m": 1.304,
        "focus_note": "Nozzle bank centre (0.1, 0.0, 0.65).",
        "clip_start_m": 0.05, "clip_end_m": 100
      }
    },
    "inspection-station": {
      "role": "Optional fallback for inspection. Wider 32 mm view of the whole inspection station: belt, scan line, light bars and camera housing. Beans are about 20 px wide at 1920 px, so this shot shows no bean surface.",
      "rig": "inspection",
      "aspect": [16, 9],
      "blueprint": {"edge_radius_m": 0.0015, "rim_range": [0.88, 0.97]},
      "camera": {
        "location": [0.60, -0.55, 1.0], "target": [-0.12, 0.0, 0.80],
